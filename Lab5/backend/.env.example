# Скопіюйте цей файл у .env (сам .env у репозиторій не потрапляє)
PORT=3000
DB_HOST=localhost
DB_PORT=5433
DB_USER=cyber
DB_PASSWORD=cyber_password
DB_NAME=cyberpolice
DB_LOGGING=false

# Адреса(и) фронтенду, з яких браузеру дозволено звертатися до API (через кому)
CORS_ORIGIN=http://localhost:5173

# Секрети підпису JWT: щонайменше 32 символи, обов’язково різні.
# Значення нижче лише для розробки, у реальному середовищі замініть на власні.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789abcdef
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-fedcba9876543210
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_COST=10

# Перший адміністратор створюється при запуску, якщо заданo обидва поля
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin2027Pass
